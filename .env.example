# Direct OpenAI API — for local testing only
# For production replace with Azure OpenAI vars below
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Azure OpenAI — for production at Bruker
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Search
SERPAPI_KEY=your-serpapi-key-here
# Department-domain probe: when true (default) it runs a cross-domain fallback
# SERP query that catches departments hosted on a separate brand domain
# (better department-URL hit rate). Set false to cap the probe at one SERP
# call per record if search cost matters more than department coverage.
DEPT_PROBE_CROSS_DOMAIN=true

# ROR
ROR_API_BASE=https://api.ror.org/v2/organizations
ROR_CONFIDENCE_THRESHOLD=0.8

# Pipeline
FUZZY_MATCH_THRESHOLD=80
MAX_PAGE_CONTENT_CHARS=3000
DEFAULT_MAX_CONCURRENCY=5
PAGE_FETCH_TIMEOUT_SECONDS=10

# Local dev
MOCK_EXTERNAL_CALLS=false
ENV=local
LOG_LEVEL=INFO
