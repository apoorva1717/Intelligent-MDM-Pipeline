# Azure OpenAI — the only LLM backend (all Phase 1 + Phase 2 calls). Required.
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Deployment for Phase 1 enrichment (and Phase 2 dedup unless
# AOAI_DEPLOYMENT_DEDUP below overrides it).
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# REST API version for Phase 1 calls.
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# TLS / corporate VPN
# A corporate VPN that inspects TLS (SSL interception) presents its OWN root
# CA, which certifi does not trust — so LLM calls hang/fail the moment the VPN
# connects. Export the corp root CA as a .pem and point one of these at it:
# AZURE_OPENAI_CA_BUNDLE=corp-root-ca.pem
# REQUESTS_CA_BUNDLE=C:\path\to\corp-root-ca.pem
# Last resort only (insecure — disables certificate verification for LLM calls):
# LLM_SSL_VERIFY=false
# The VPN's proxy is honored automatically from these standard vars if set:
# HTTPS_PROXY=http://proxy.corp:8080
# HTTP_PROXY=http://proxy.corp:8080
# NO_PROXY=localhost,127.0.0.1,.corp.local
# Handshake/read timeouts (seconds) — bump if the tunnel is slow:
# LLM_HTTP_CONNECT_TIMEOUT=30
# LLM_HTTP_TIMEOUT=60

# Phase 2 dedup adjudicator (POST /api/dedup/cluster-block)
# AI Foundry deployment for the full GPT-5.4 model used by the adjudicator.
AOAI_DEPLOYMENT_DEDUP=gpt-5.4
# REST API version for the adjudicator. GPT-5.x reasoning models and the
# reasoning_effort parameter need a newer version than the Phase 1 default
# (2024-08-01-preview). Override here if your resource exposes a different one.
AOAI_API_VERSION_DEDUP=2025-04-01-preview
# Reasoning effort for the adjudicator (reasoning models may ignore temperature).
DEDUP_REASONING_EFFORT=low
# Signature count at/below which a block uses one partition call (Mode A);
# above it, incremental canonical assignment (Mode B).
SIG_PARTITION_THRESHOLD=12
# Max in-flight adjudicator LLM calls across all blocks in a request.
DEDUP_MAX_CONCURRENCY=5
# Max attempts per adjudicator call (retries 429/5xx with exponential backoff).
DEDUP_MAX_RETRIES=3
# Golden-record election: a duplicate merge whose adjudication confidence is
# below this is demoted to manual_review (a human confirms before a block).
# Pure data retune — changing it never re-runs the LLM.
CONFIDENCE_MERGE_THRESHOLD=0.95
# Dedup residue candidate nomination. A signature pair the bucketed pass never
# compared becomes an LLM adjudication candidate when suffix-stripped name
# similarity (Jaro-Winkler) >= NAME_CANDIDATE_THRESHOLD, or token-set Jaccard >=
# TOKEN_CANDIDATE_THRESHOLD, or their ROR/LEI converge. Nomination never merges.
# Over MAX_CANDIDATES_PER_BLOCK LLM calls the block routes to manual_review.
NAME_CANDIDATE_THRESHOLD=0.85
TOKEN_CANDIDATE_THRESHOLD=0.6
MAX_CANDIDATES_PER_BLOCK=50

# Search
SERPAPI_KEY=your-serpapi-key-here
# Department-domain probe: when true (default) it runs a cross-domain fallback
# SERP query that catches departments hosted on a separate brand domain
# (better department-URL hit rate). Set false to cap the probe at one SERP
# call per record if search cost matters more than department coverage.
DEPT_PROBE_CROSS_DOMAIN=true

# ROR
ROR_API_BASE=https://api.ror.org/v2/organizations
ROR_CONFIDENCE_THRESHOLD=0.8

# GLEIF / LEI (Tier 1 company registry — the company counterpart to ROR).
# For company-type records, resolves the official legal name + Legal Entity
# Identifier from the free GLEIF API before falling back to LLM canonicalization.
# Set LEI_LOOKUP_ENABLED=false to disable (behaviour reverts to LLM-only).
LEI_LOOKUP_ENABLED=true
GLEIF_API_BASE=https://api.gleif.org/api/v1
GLEIF_TIMEOUT_SECONDS=15
# rapidfuzz token_sort_ratio (0-100) a candidate legalName must reach to be
# accepted. GLEIF fuzzy is statistical — below this we never accept a hit.
LEI_NAME_MATCH_THRESHOLD=88
LEI_MAX_RETRIES=2

# Pipeline
FUZZY_MATCH_THRESHOLD=80
MAX_PAGE_CONTENT_CHARS=3000
DEFAULT_MAX_CONCURRENCY=5
PAGE_FETCH_TIMEOUT_SECONDS=10

# Local dev
MOCK_EXTERNAL_CALLS=false
ENV=local
LOG_LEVEL=INFO
# Log file path. Logs go to BOTH the console and this rotating file (~10 MB,
# 5 backups). Defaults to logs/enrichment_api.log when unset; set LOG_FILE=
# (empty) to log to the console only.
# LOG_FILE=logs/enrichment_api.log
