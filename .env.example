# Azure OpenAI — the only LLM backend (all Phase 1 + Phase 2 calls). Required.
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Deployment for Phase 1 enrichment (and Phase 2 dedup unless
# AOAI_DEPLOYMENT_DEDUP below overrides it).
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# REST API version for Phase 1 calls.
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# TLS / corporate VPN
# A corporate VPN that inspects TLS (SSL interception) presents its OWN root
# CA, which certifi does not trust — so LLM calls hang/fail the moment the VPN
# connects. Export the corp root CA as a .pem and point one of these at it:
# AZURE_OPENAI_CA_BUNDLE=corp-root-ca.pem
# REQUESTS_CA_BUNDLE=C:\path\to\corp-root-ca.pem
# Last resort only (insecure — disables certificate verification for LLM calls):
# LLM_SSL_VERIFY=false
# The VPN's proxy is honored automatically from these standard vars if set:
# HTTPS_PROXY=http://proxy.corp:8080
# HTTP_PROXY=http://proxy.corp:8080
# NO_PROXY=localhost,127.0.0.1,.corp.local
# Handshake/read timeouts (seconds) — bump if the tunnel is slow:
# LLM_HTTP_CONNECT_TIMEOUT=30
# LLM_HTTP_TIMEOUT=60

# Phase 2 dedup adjudicator (POST /api/dedup/cluster-block)
# AI Foundry deployment for the full GPT-5.4 model used by the adjudicator.
AOAI_DEPLOYMENT_DEDUP=gpt-5.4
# REST API version for the adjudicator. GPT-5.x reasoning models and the
# reasoning_effort parameter need a newer version than the Phase 1 default
# (2024-08-01-preview). Override here if your resource exposes a different one.
AOAI_API_VERSION_DEDUP=2025-04-01-preview
# Reasoning effort for the adjudicator (reasoning models may ignore temperature).
DEDUP_REASONING_EFFORT=low
# Signature count at/below which a block uses one partition call (Mode A);
# above it, incremental canonical assignment (Mode B).
SIG_PARTITION_THRESHOLD=12
# Max in-flight adjudicator LLM calls across all blocks in a request.
DEDUP_MAX_CONCURRENCY=5
# Max attempts per adjudicator call (retries 429/5xx with exponential backoff).
DEDUP_MAX_RETRIES=3
# Golden-record election: a duplicate merge whose adjudication confidence is
# below this is demoted to manual_review (a human confirms before a block).
# Pure data retune — changing it never re-runs the LLM.
CONFIDENCE_MERGE_THRESHOLD=0.95
# Dedup residue candidate nomination. A signature pair the bucketed pass never
# compared becomes an LLM adjudication candidate when suffix-stripped name
# similarity (Jaro-Winkler) >= NAME_CANDIDATE_THRESHOLD, or token-set Jaccard >=
# TOKEN_CANDIDATE_THRESHOLD, or their ROR/LEI converge. Nomination never merges.
# Over MAX_CANDIDATES_PER_BLOCK LLM calls the block routes to manual_review.
NAME_CANDIDATE_THRESHOLD=0.85
TOKEN_CANDIDATE_THRESHOLD=0.6
MAX_CANDIDATES_PER_BLOCK=50

# Search
SERPAPI_KEY=your-serpapi-key-here
# Department-domain probe: when true (default) it runs a cross-domain fallback
# SERP query that catches departments hosted on a separate brand domain
# (better department-URL hit rate). Set false to cap the probe at one SERP
# call per record if search cost matters more than department coverage.
DEPT_PROBE_CROSS_DOMAIN=true

# ROR
ROR_API_BASE=https://api.ror.org/v2/organizations
ROR_CONFIDENCE_THRESHOLD=0.8

# GLEIF / LEI (Tier 1 company registry — the company counterpart to ROR).
# For company-type records, resolves the official legal name + Legal Entity
# Identifier from the free GLEIF API before falling back to LLM canonicalization.
# Set LEI_LOOKUP_ENABLED=false to disable (behaviour reverts to LLM-only).
LEI_LOOKUP_ENABLED=true
GLEIF_API_BASE=https://api.gleif.org/api/v1
GLEIF_TIMEOUT_SECONDS=15
# rapidfuzz token_sort_ratio (0-100) a candidate legalName must reach to be
# accepted. GLEIF fuzzy is statistical — below this we never accept a hit.
LEI_NAME_MATCH_THRESHOLD=88
LEI_MAX_RETRIES=2

# Domain ownership guard (utils/domain_resolver.py) — the domain-path
# counterpart to ROR's country guard and GLEIF's name verification. A
# web-derived domain is only attributed to the organisation when Name 1 reaches
# this rapidfuzz token_sort_ratio (0-100) against the domain label, or the
# record's own email / an on-domain search result corroborates it. Registry
# (ROR/GLEIF) provenance always passes. Failing every condition leaves the
# Domain column empty and flags the record `domain-unverified`.
DOMAIN_NAME_MATCH_THRESHOLD=82
# Set false to A/B disable the guard (candidates are still canonicalised to the
# registrable domain; only the ownership conditions are skipped).
DOMAIN_OWNERSHIP_GUARD_ENABLED=true

# Pipeline
FUZZY_MATCH_THRESHOLD=80
MAX_PAGE_CONTENT_CHARS=3000
DEFAULT_MAX_CONCURRENCY=5
PAGE_FETCH_TIMEOUT_SECONDS=10

# Page-read corroborator (Fix 3, enrichment/page_corroborator.py). When a
# candidate domain exists — accepted, or discarded as `domain-unverified` — and
# the record is not already registry-resolved, the site is fetched and an LLM
# reads what the page STATES about the organisation. A consistent name clears
# `domain-unverified` and writes `operating_name`; a page naming a different
# organisation WITHDRAWS an accepted domain. Name 1 is never written by this
# step: a page is a witness, not an authority.
PAGE_CORROBORATION_ENABLED=true
# rapidfuzz token_sort_ratio (0-100) an extracted page name must reach against
# Name 1. Uses GLEIF's own scorer (tier1_lei._name_match_score) and inherits
# LEI_NAME_MATCH_THRESHOLD's derivation — same comparison, same default.
PAGE_NAME_MATCH_THRESHOLD=88
# Hard per-request timeout for a corroboration fetch. Shorter than
# PAGE_FETCH_TIMEOUT_SECONDS: this is optional evidence on a path that already
# has an answer, and up to five requests may be issued per domain.
PAGE_READ_TIMEOUT_SECONDS=8
# Where page reads are recorded, one JSON file per domain, so a re-run
# reproduces its corroboration decisions instead of re-asking today's web.
# Set empty to disable the fixture store (memory-only).
PAGE_FIXTURE_DIR=tests/fixtures/page_reads
# Refuse to fetch anything not already recorded — a missing fixture surfaces as
# `fetch_unavailable` rather than a silent new network call. For CI / offline
# re-analysis.
PAGE_FIXTURE_REPLAY_ONLY=false
# Offer a page-extracted legal name to the Stage 5 Tier 1 retry as a lookup
# candidate. OFF by default: the Stage 5 trace shows its yield is bounded by
# GLEIF's coverage of private US SMBs, not by the supply of candidate names.
PAGE_EXTRACT_FEEDS_RETRY=false

# Wikidata crosswalk lane (Stage 2c, enrichment/wikidata.py). Runs on a record
# ROR and GLEIF both missed, between the registry miss and the web-evidence
# step. Wikidata is a CROSSWALK and a WITNESS, never an authority: an item
# carrying a ROR ID (P6782) or LEI (P1278) buys a lookup that ROR/GLEIF then
# answer under their own unchanged guards, and an item with no pointer may
# write at most `operating_name`. Never `name1_enriched`. No LLM is involved,
# and the SPARQL endpoint is never used.
WIKIDATA_ENABLED=true
# The lane's SECOND role: on a record the registries ALREADY resolved, the
# crosswalk lane declines to run (a register outranks a wiki, and a resolved
# record has no pointer to gain). It still has the item's P856 to gain — an
# independent statement of the official website, and the one piece of evidence
# that can verify a candidate domain a name comparison cannot reach (an acronym
# host, a contraction, a brand domain). So the lane runs in a corroboration-ONLY
# mode there: same gauntlet, and the only effect is to retain the website claim.
# It follows no pointer, writes no name and touches no field.
#
# This is the one request the domain-witness calibration adds, which is why it
# has its own switch. Set false to A/B the `+wikidata` domain witness back out
# on a stratum where Wikidata coverage does not repay the call.
WIKIDATA_DOMAIN_CORROBORATION=true
WIKIDATA_API_BASE=https://www.wikidata.org/w/api.php
# Short: the lane is optional evidence on a record that proceeds either way.
WIKIDATA_TIMEOUT_SECONDS=10
# Transient errors only (5xx / network / 429), exponential backoff.
WIKIDATA_MAX_RETRIES=2
# Candidates run through the gauntlet. All of them are fetched in ONE batched
# entity call, which is what makes the two-survivors collision check
# affordable inside the per-record call budget.
WIKIDATA_SEARCH_LIMIT=5
# Where responses are recorded, one JSON file per key (query string for a
# search, QID for an entity). Wikidata is an open wiki whose items change under
# you, so a matching decision is a claim about what it said on a day.
# Set empty to disable the fixture store (memory-only).
WIKIDATA_FIXTURE_DIR=tests/fixtures/wikidata
# Refuse to call anything not already recorded — an unrecorded query surfaces
# as `wikidata_unavailable`. The mode the test suite runs under, and what an
# offline re-analysis wants.
WIKIDATA_FIXTURE_REPLAY_ONLY=false
# One JSON line per lane invocation on `enrichment.trace.wikidata`, carrying
# every candidate and why it was refused. Diagnostic only — the batch-summary
# counters are maintained whether this is on or off.
WIKIDATA_TRACE=false
# NOTE: the lane adds no name threshold of its own. It reuses
# LEI_NAME_MATCH_THRESHOLD and GLEIF's own scorer.

# ---------------------------------------------------------------------------
# The shared evidence cache (Fix B) --- utils/cache.py
# ---------------------------------------------------------------------------
# ONE directory for every external answer the pipeline reads, one subdirectory
# per source: page_reads/, wikidata/, serp/, fetch/, registry/, llm/. Every key
# is a pure function of the request --- never a run id, a batch id or a date ---
# which is what makes a second run of a batch HIT rather than re-gather. Two
# runs of the identical 101-row chemspeed batch used to differ on 7 records,
# 11 of the differing cells being nothing but an extraction date.
# PAGE_FIXTURE_DIR and WIKIDATA_FIXTURE_DIR above still override their own
# namespaces. Set empty for a memory-only run.
EVIDENCE_CACHE_DIR=tests/fixtures
# The EVALUATION FREEZE SWITCH --- the analogue of freezing dedup/weights.json
# before a measurement. When true a cache miss is an ERROR, not a call: it is
# recorded per record as `evidence-unavailable-frozen` on the
# `enrichment.trace.cache` logger, counted in the batch summary, and the record
# proceeds without that piece of evidence. Applies to every namespace at once.
CACHE_FROZEN=false

# Diagnostics (off by default; enabling only adds JSON trace lines and never
# changes pipeline behaviour).
# WEBSITE_TRACE=false   # per-candidate Path B / Path C website resolution
# RETRY_TRACE=false     # per-record Stage 5 Tier 1 re-lookup
# enrichment.trace.cache        # frozen-cache misses (no env var; always on)
# enrichment.trace.consistency  # cross-source gate actions (no env var)

# Local dev
MOCK_EXTERNAL_CALLS=false
ENV=local
LOG_LEVEL=INFO
# Log file path. Logs go to BOTH the console and this rotating file (~10 MB,
# 5 backups). Defaults to logs/enrichment_api.log when unset; set LOG_FILE=
# (empty) to log to the console only.
# LOG_FILE=logs/enrichment_api.log
